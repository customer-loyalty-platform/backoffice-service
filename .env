APP_ENV=development
APP_PORT=8080

# PostgreSQL (from d:\loyalty\env)
DB_MASTER_DSN=postgres://postgres:postgres@localhost:5432/loyalty_databases?sslmode=disable
DB_REPLICA_DSN=postgres://postgres:postgres@localhost:5432/loyalty_databases?sslmode=disable

DB_MAX_CONNS=50
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE=5m
DB_MAX_CONN_LIFE=30m

JWT_SECRET=loyalty-backoffice-jwt-secret-key-2024-secure
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=168h

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

